{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",          // أو "node16" / "nodenext" لو لسه مش شغال
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "types": ["node"]                       // مهم لـ process.env إلخ
  },
  "include": [
    "vite.config.ts",
    "vite.config.mts"   // لو بتستخدم .mts
  ]
}

